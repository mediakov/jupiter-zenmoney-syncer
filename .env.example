# Copy to `.env` (gitignored) — docker compose reads it automatically.
# Everything here is optional; Jupiter email + ZenMoney token can also be set
# from the web UI at http://localhost:8080.

# Jupiter account email (or set it later in the UI)
JUP_EMAIL=

# ZenMoney API token — get one at https://zerro.app/token (or set it in the UI)
ZEN_TOKEN=

# Full-history Solana RPC for deposit→transfer tracing (Helius/QuickNode/Triton).
# Without a full-history RPC, deposits older than a few days won't resolve.
SOLANA_RPC=

# How often to sync (e.g. 30m, 6h, 1d)
SYNC_INTERVAL=6h

# Years to sync (default: current + previous). e.g. 2025,2026
SYNC_YEARS=

# Protect the POST endpoints with a bearer token. If set, enter the same value
# in the SwiftBar plugin (JUPZEN_TOKEN) and the web UI "Admin token" box.
SERVICE_TOKEN=

# Set to 1 to read + convert without pushing to ZenMoney (preview).
DRY_RUN=
